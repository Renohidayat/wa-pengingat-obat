# Environment
NODE_ENV=development
TZ=Asia/Jakarta
LOG_LEVEL=info

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/wa-pengingat-obat

# Admin WhatsApp Numbers (pisahkan dengan koma jika lebih dari satu, format internasional tanpa tanda +, contoh: 6281234567890)
ADMIN_NUMBERS=6281234567890

# Sesi Baileys (opsional jika ingin custom direktori auth)
AUTH_DIR=./auth_info
